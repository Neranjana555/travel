      <div class=\"gallery-item fade-up\"><img src=\"https://z-cdn-media.chatglm.cn/files/3e97181f-a952-4675-8ce8-df7ea42f850f.png?auth_key=1885316737-9f5a8d84e440423398c446742c91e7d6-0-f11c1d0dd7da5998eec2bb00aea5c7e8\" alt=\"Mirissa Coconut Tree Hill\" loading=\"lazy\"></div>\n                <div class=\"gallery-item fade-up\"><img src=\"https://z-cdn-media.chatglm.cn/files/72594d5d-b48b-4992-b13a-97ea2fae23ca.png?auth_key=1885316737-0349a49635964da493ee772c89dd4b20-0-063c083bd7dbd92bc22ee801bdb06f40\" alt=\"Galle Fort Lighthouse\" loading=\"lazy\"></div>\n                <div class=\"gallery-item fade-up\"><img src=\"https://z-cdn-media.chatglm.cn/files/f6eb297f-237a-405f-826b-02df41ed4467.png?auth_key=1885316737-d1a6d4b8782941259c5daadf34f78b93-0-f6cf35dfd630a575357b6dda1084e777\" alt=\"Unawatuna Beach\" loading=\"lazy\"></div>\n            </div>\n        </div>\n    </section>",
